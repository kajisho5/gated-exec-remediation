        "params": {
          "steps": [
            {
              "blocking": true,
              "id": "s1",
              "text": "この作業ツリーで npm ci / npm install / pip install -r / bundle install を実行しない（ロックファイルが侵害版・脆弱版を再び取得する）。対象: /srv/zes-fixtures/chaindrop/package-lock.json"
            },
            {
              "blocking": true,
              "id": "s2",
              "text": "~/.npmrc に ignore-scripts=true、環境変数に PIP_REQUIRE_VIRTUALENV=true と PYTHONNOUSERSITE=1 を設定する"
            },
            {
              "blocking": true,
              "id": "s3",
              "text": "依存の指定を安全版・修正版に変え、秘密情報の無い隔離環境でロックファイルを再生成する（npm install --ignore-scripts / poetry lock / uv lock / bundle lock --update / cargo update -p など）"
            },
            {
              "blocking": true,
              "id": "s4",
              "text": "npm ls <name> / pip show / bundle info / cargo tree で侵害版・脆弱版が残っていないことを確かめる"
            },
            {
              "blocking": true,
              "id": "s5",
              "text": "侵害版がインストール・実行された可能性があれば CL-SECRET を実施する"
            },
            {
              "blocking": true,
              "id": "s6",
              "text": "ZES で再スキャンし、この finding が消えたことを確かめる"
            }
          ],
          "template": "CL-PKG"
        },
