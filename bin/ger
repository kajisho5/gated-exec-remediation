#!/usr/bin/env bash
# GER launcher. Resolves paths without external commands (bash builtins only) and runs
# python3 -I -S (ignores environment variables, site (including .pth files) and the current directory).
set -euo pipefail
SELF="${BASH_SOURCE[0]}"
case "$SELF" in */*) ;; *) SELF="./$SELF" ;; esac
BIN_DIR="$(cd "${SELF%/*}" && pwd -P)"
exec python3 -I -S "${BIN_DIR%/*}/ger/__main__.py" "$@"
